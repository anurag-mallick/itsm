# Copy this file to .env and fill in all values before running docker-compose up

# Django
SECRET_KEY=change-this-to-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=helpdesk.yourdomain.local,192.168.x.x

# Database
DB_NAME=itsm
DB_USER=itsm_user
DB_PASSWORD=change-this-strong-password
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Outbound email — iRedMail SMTP
SMTP_HOST=192.168.x.x
SMTP_PORT=465  # 465=SSL/TLS  587=STARTTLS
SMTP_USER=helpdesk@yourdomain.local
SMTP_PASSWORD=change-this-password
SMTP_USE_TLS=True
EMAIL_FROM=helpdesk@yourdomain.local

# Inbound email — iRedMail IMAP
IMAP_HOST=192.168.x.x
IMAP_PORT=993
IMAP_USER=helpdesk@yourdomain.local
IMAP_PASSWORD=change-this-password
IMAP_SSL=True
IMAP_PROCESSED_FOLDER=INBOX.Processed

# Inbound email protocol — set to 'pop3' to use POP3 instead of IMAP
EMAIL_INBOUND_PROTOCOL=imap

# Inbound email — POP3 (used when EMAIL_INBOUND_PROTOCOL=pop3)
# If POP3_HOST/USER/PASSWORD are blank, falls back to IMAP_HOST/USER/PASSWORD values above
POP3_HOST=
POP3_PORT=995
POP3_USER=
POP3_PASSWORD=

# Hardware asset auto-discovery — SSH credentials for Linux/Unix hosts
# Leave blank to disable SSH-based info collection during scans
DISCOVERY_SSH_USER=
DISCOVERY_SSH_PASSWORD=

# Microsoft Teams (Azure App Registration)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# Frontend origin (used for CORS)
FRONTEND_URL=https://helpdesk.yourdomain.local

# Initial admin email (used only on first deployment)
ADMIN_EMAIL=admin@helpdesk.local
