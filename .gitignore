# Environment — never commit real secrets
.env
.env.local

# SSL certificates
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.pem

# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.eggs/

# Django
*.log
db.sqlite3
db_local.sqlite3
backend/db_local.sqlite3
/backend/media/
/backend/staticfiles/
backend/initial_credentials*
initial_credentials*

# Local dev settings with credentials — use .env for production
# backend/config/settings/local.py is committed but credentials must be placeholders

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Docker volumes (if accidentally created locally)
postgres_data/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
